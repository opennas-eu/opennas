#!/sbin/openrc-run
# OpenNAS backend service (Alpine / OpenRC).
# Config lives in /etc/conf.d/opennas (sourced automatically by OpenRC).

name="OpenNAS"
description="OpenNAS web NAS backend"

: "${OPENNAS_DIR:=/usr/lib/opennas}"
: "${OPENNAS_USER:=opennas}"
: "${OPENNAS_GROUP:=opennas}"
: "${OPENNAS_DATA_DIR:=/var/lib/opennas}"

command="/usr/bin/node"
command_args="${OPENNAS_DIR}/server/index.js"
command_user="${OPENNAS_USER}:${OPENNAS_GROUP}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/opennas.log"
error_log="/var/log/opennas.log"

depend() {
	need net
	use dns logger
	after firewall
}

start_pre() {
	# The data dir is root's and sticky, writable by the service group: the
	# backend creates and replaces its own files in it, but cannot rename the
	# root-owned share roots inside (see opennas-sysctl share-roots).
	checkpath -d -m 1770 -o "root:${OPENNAS_GROUP}" "${OPENNAS_DATA_DIR}"
	if [ -x "${OPENNAS_DIR}/opennas-sysctl" ]; then
		"${OPENNAS_DIR}/opennas-sysctl" share-roots >/dev/null 2>&1 || ewarn "could not secure the share roots"
	fi
	checkpath -f -m 0640 -o "${OPENNAS_USER}:${OPENNAS_GROUP}" "${output_log}"
}
