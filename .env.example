# -- OpenNAS configuration ----------------------------------------------
# Copy to .env (or set in your systemd unit / Docker) and adjust.

# --- Server ---
OPENNAS_HOST=0.0.0.0
OPENNAS_PORT=4174
OPENNAS_DATA_DIR=./data            # SQLite DB + secrets live here

# --- Frontend / backend topology ---
# The backend (this service) and the frontend (static SPA) are decoupled.
#
# Default ("appliance") topology: one public origin via a reverse proxy that
# serves the built SPA and forwards /api + /api/ws to this service. No extra
# config needed - the SPA calls a relative /api and the session cookie stays
# SameSite=Lax.
#
# Split-origin topology: the SPA is hosted on a DIFFERENT origin than the API.
# Then BOTH ends must use HTTPS, and you must:
#   1) list the SPA origin(s) here so CORS allows credentialed calls, and
#   2) build the frontend with VITE_OPENNAS_API_BASE=https://<this-api>/api
# Setting this also flips the session cookie to SameSite=None;Secure.
# OPENNAS_CORS_ORIGINS=https://app.example.com

# File Station share root. Everything File Station can see lives under here;
# anything outside is rejected. Relative paths are under OPENNAS_DATA_DIR.
# Point this at your real storage on the NAS, e.g. /mnt/storage.
OPENNAS_FILES_ROOT=shared

# --- File sharing (SMB/NFS) ---
# OpenNAS generates smb.conf / exports from your shares and mirrors them into
# OPENNAS_DATA_DIR/generated on every change. Optionally point these at the real
# daemon files so a created share is live with no manual copying (needs write
# access to those paths - typically run as root or via a writable include file).
# OPENNAS_SMB_CONF=/etc/samba/smb.conf
# OPENNAS_NFS_EXPORTS=/etc/exports

# --- WebAuthn / passkeys ---
# rpID must be the site's domain (no scheme/port); origin is the full origin
# the browser sees. In dev these match the Vite server.
OPENNAS_RP_NAME=OpenNAS
OPENNAS_RP_ID=localhost
OPENNAS_ORIGIN=http://localhost:5173
# In production behind a domain, e.g.:
#   OPENNAS_RP_ID=nas.example.com
#   OPENNAS_ORIGIN=https://nas.example.com
#   OPENNAS_COOKIE_SECURE=true

# --- OIDC / SSO (optional) ---
# Set issuer + client id to enable "Login with SSO".
# OPENNAS_OIDC_ISSUER=https://auth.example.com/application/o/lynas/
# OPENNAS_OIDC_CLIENT_ID=lynas
# OPENNAS_OIDC_CLIENT_SECRET=...
# OPENNAS_OIDC_REDIRECT_URI=https://nas.example.com/api/auth/oidc/callback
# OPENNAS_OIDC_BUTTON_LABEL=Login with SSO
# OPENNAS_OIDC_AUTOCREATE=true
